    "video:doctor": "node scripts/analyze-video.mjs --doctor",
    "show:story": "node scripts/preview-show.mjs --narrative",
    "public:verify-native": "node scripts/public-events.mjs native-sticker-separation",
    "friends:sync": "node scripts/friends.mjs",
    "groups:sync": "node scripts/groups.mjs",
    "verify": "node scripts/verify.mjs",
    "storage:setup": "node scripts/storage.mjs setup",
    "storage:migrate": "node scripts/storage.mjs migrate",
