  "engines": {
    "node": ">=22"
  },
  "bin": {
    "douyin-gpt": "./src/cli.mjs"
  },
  "scripts": {
    "init": "node src/cli.mjs init",
    "login": "node src/cli.mjs login",
    "doctor": "node src/cli.mjs doctor",
    "contacts": "node src/cli.mjs contacts",
    "preview": "node src/cli.mjs once",
    "start": "node src/cli.mjs start --live",
    "start:background": "node scripts/background.mjs start",
    "start:local": "node scripts/start-local.mjs",
    "status:local": "node scripts/start-local.mjs --status",
    "stop": "node scripts/background.mjs stop",
    "status:background": "node scripts/background.mjs status",
    "status": "node src/cli.mjs status",
    "journal": "node src/cli.mjs journal",
    "demo": "node scripts/demo.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "evening": "node scripts/evening.mjs",
    "dashboard": "node scripts/dashboard.mjs start",
    "dashboard:status": "node scripts/dashboard.mjs status",
