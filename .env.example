# 复制为 .env，密钥仅保存在本机，不要发到聊天里。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.openai.com/v1
# 可选第二个模型，配额独立；开启 config.json 的 deepseek.enabled 后生效。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Mac 默认自动查找 Chrome / Edge；安装在其他位置时才需要填写。
# DOUYIN_BROWSER=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 默认数据目录是项目内 .data，也可以设置一个专用的绝对路径。
# DOUYIN_GPT_HOME=/absolute/path/to/douyin-gpt-data
# 管理服务：本机默认 127.0.0.1；局域网/服务器可改为 0.0.0.0。
# DOUYIN_DASHBOARD_HOST=0.0.0.0
# 通过域名或反向代理访问时，填写对外的完整来源地址（无子路径）。
# DOUYIN_DASHBOARD_URL=https://assistant.example.com
# Docker 发布端口可独立配置；默认仍只发布到本机。
# DOUYIN_DASHBOARD_BIND=0.0.0.0
# DOUYIN_DASHBOARD_PORT=3147
# DOUYIN_DESKTOP_BIND=127.0.0.1
# DOUYIN_DESKTOP_PORT=6080
# 业务数据库由 storage:setup 创建私有密码和连接文件；不在环境中填写密码。
# DOUYIN_DATABASE_PORT=15432
# 运行真实PostgreSQL集成测试时只传私有连接文件路径，不传密码。
# DOUYIN_STORAGE_TEST_CONNECTION_FILE=/absolute/private/path/storage-connection.json
