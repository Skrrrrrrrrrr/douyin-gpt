# 复制为 .env，密钥仅保存在本机，不要发到聊天里。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.openai.com/v1
# Mac 默认自动查找 Chrome / Edge；安装在其他位置时才需要填写。
# DOUYIN_BROWSER=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 默认数据目录是项目内 .data，也可以设置一个专用的绝对路径。
# DOUYIN_GPT_HOME=/absolute/path/to/douyin-gpt-data
